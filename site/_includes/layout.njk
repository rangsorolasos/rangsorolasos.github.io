<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body onload="if (document.cookie == 'redir_seen=true') {document.getElementById('redir-bar').style.display = 'none';}">

  {% include "navbar.njk" %}
  {% include "redir.njk" %}
  {% include "kpi.njk" %}

  <main class="content">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <p>
      © 2026
      <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.hu">CC-BY-SA</a>
      <a href="https://kdea.hu">Közösségi Digitális Eszközök Alapítvány</a>
      {{ buildDate | formatBuildDate }}
    </p>
  </footer>

</body>
</html>
